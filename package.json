{
  "name": "tellurion",
  "displayName": "Tellurion",
  "description": "Products are planets, features are moons; nothing appears until work starts, and nothing glows without a recorded exit 0.",
  "version": "0.2.1",
  "engines": {
    "vscode": "^1.85.0"
  },
  "publisher": "tbk-labs",
  "license": "MIT",
  "icon": "media/tellurion-icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:tellurion.openSky",
    "onCommand:tellurion.openOrrery",
    "onCommand:tellurion.startInception",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tellurion.openSky",
        "title": "Tellurion: Open Sky",
        "icon": "$(symbol-class)"
      },
      {
        "command": "tellurion.openOrrery",
        "title": "Tellurion: Open the instrument",
        "icon": "$(symbol-class)"
      },
      {
        "command": "tellurion.startInception",
        "title": "Tellurion: Start Inception",
        "icon": "$(play)"
      },
      {
        "command": "tellurion.refreshScan",
        "title": "Tellurion: Refresh Scan",
        "icon": "$(refresh)"
      },
      {
        "command": "tellurion.switchStyle",
        "title": "Tellurion: Switch Style",
        "icon": "$(paintcan)"
      },
      {
        "command": "tellurion.switchTheme",
        "title": "Tellurion: Switch Theme",
        "icon": "$(color-mode)"
      },
      {
        "command": "tellurion.enrichContext",
        "title": "Tellurion: Enrich planet with Context.dev",
        "icon": "$(globe)"
      },
      {
        "command": "tellurion.showEvents",
        "title": "Tellurion: Show Convex events",
        "icon": "$(history)"
      }
    ],
    "configuration": {
      "title": "Tellurion",
      "properties": {
        "tellurion.style": {
          "type": "string",
          "enum": [
            "futuristic",
            "rustic"
          ],
          "default": "rustic",
          "description": "Visual style of the sky."
        },
        "tellurion.theme": {
          "type": "string",
          "enum": [
            "dark",
            "light",
            "auto"
          ],
          "default": "light",
          "description": "Sky color theme. Auto follows the active VS Code theme."
        }
      }
    },
    "keybindings": [
      {
        "command": "tellurion.openSky",
        "key": "ctrl+alt+t",
        "mac": "cmd+alt+t",
        "when": "editorTextFocus"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen"
  },
  "dependencies": {
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
