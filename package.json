{
  "name": "tellurion",
  "displayName": "Tellurion — Visual Project Orrery",
  "description": "A VS Code extension that visualises your project as a living orrery: deliverables as planets, features as moons, and the plan as the spine.",
  "version": "0.1.0",
  "engines": {
    "vscode": "^1.85.0"
  },
  "publisher": "tbk-labs",
  "license": "MIT",
  "icon": "media/tellurion-icon.png",
  "categories": [
    "Visualization",
    "Other"
  ],
  "activationEvents": [
    "onCommand:tellurion.openOrrery",
    "onCommand:tellurion.startInception",
    "onStartupFinished"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "tellurion.openOrrery",
        "title": "Tellurion: Open the instrument",
        "icon": "$(symbol-class)"
      },
      {
        "command": "tellurion.startInception",
        "title": "Tellurion: Start Inception",
        "icon": "$(play)"
      },
      {
        "command": "tellurion.refreshScan",
        "title": "Tellurion: Refresh scan",
        "icon": "$(refresh)"
      },
      {
        "command": "tellurion.enrichContext",
        "title": "Tellurion: Enrich planet with Context.dev",
        "icon": "$(globe)"
      },
      {
        "command": "tellurion.showEvents",
        "title": "Tellurion: Show Convex events",
        "icon": "$(history)"
      }
    ],
    "keybindings": [
      {
        "command": "tellurion.openOrrery",
        "key": "ctrl+shift+t",
        "mac": "cmd+shift+t"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "package": "npm run compile && npx @vscode/vsce package --no-dependencies",
    "convex:dev": "convex dev",
    "convex:codegen": "convex codegen"
  },
  "dependencies": {
    "convex": "^1.45.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@types/vscode": "^1.85.0",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.0"
  }
}
