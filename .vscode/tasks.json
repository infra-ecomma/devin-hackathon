{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "compile",
      "type": "shell",
      "command": "npm run compile",
      "group": { "kind": "build", "isDefault": true },
      "problemMatcher": "$tsc",
      "presentation": { "reveal": "silent", "panel": "shared" }
    },
    {
      "label": "watch",
      "type": "shell",
      "command": "npm run watch",
      "isBackground": true,
      "group": "build",
      "problemMatcher": {
        "base": "$tsc-watch",
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^(Starting compilation|\\[\\d+:\\d+:\\d+ (AM|PM)\\] Starting)",
          "endsPattern": "^(Found 0 errors|\\[\\d+:\\d+:\\d+ (AM|PM)\\] Found 0 errors)"
        }
      }
    }
  ]
}
